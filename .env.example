# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the keys you have. EVERYTHING IS OPTIONAL:
# with no keys at all, the pipeline still runs in free "rule-based" mode.
# The .env file is for LOCAL runs on your computer. For the automatic cloud run,
# put the same values in GitHub > Settings > Secrets and variables > Actions.
# -----------------------------------------------------------------------------

# --- AI analysis (free tier). Get a key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- US macro data (free). Get a key at https://fredaccount.stlouisfed.org/apikeys ---
FRED_API_KEY=

# --- Telegram push (free). Create a bot via @BotFather, then get your chat id. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email digest (free) via Gmail + a 16-char App Password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=            # your gmail address, e.g. you@gmail.com
SMTP_PASS=            # 16-char Gmail App Password (NOT your normal password)
EMAIL_TO=             # where to send the brief (can be your own email)

# --- Your published web page URL (optional; used in the Telegram link) ---
SITE_URL=
